# Google Gemini API Key (optional for local mock testing, required for production Gemini LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (gemini-2.5-flash or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration (Cloud Run injects PORT automatically)
PORT=8080
HOST=0.0.0.0
APP_ENV=production
