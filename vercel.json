{
  "functions": {
    "api/index.py": {
      "includeFiles": "{static/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/",
      "destination": "/api/index.py?__path__=/"
    },
    {
      "source": "/((?!api|static).*)",
      "destination": "/api/index.py?__path__=/$1"
    }
  ]
}
